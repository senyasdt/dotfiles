#!/bin/sh

set -eu

wezterm_dir="$HOME/.config/wezterm"
active_scheme_file="$wezterm_dir/active_scheme.toml"
generated_theme_file="$wezterm_dir/themes/generated.toml"
generated_palette_file="$wezterm_dir/generated_palette.json"
tmp_json="$(mktemp)"
trap 'rm -f "$tmp_json"' EXIT

require_cmd() {
	if ! command -v "$1" >/dev/null 2>&1; then
		echo "missing required command: $1" >&2
		exit 1
	fi
}

require_cmd matugen
require_cmd jq
require_cmd python3

{{- if eq .chezmoi.os "darwin" }}
require_cmd osascript
wallpaper_path="$(osascript -e 'tell application "System Events" to tell current desktop to get POSIX path of (picture as alias)' | tr -d '\r')"

if [ -z "$wallpaper_path" ]; then
	echo "failed to detect macOS wallpaper" >&2
	exit 1
fi
{{- else if eq .chezmoi.os "linux" }}
windows_wezterm_dir="/mnt/c/Users/$USER/.config/wezterm"

if ! uname -r | grep -qi "microsoft"; then
	echo "wallpaper generation is only supported from WSL on this Linux setup" >&2
	exit 1
fi

require_cmd powershell.exe
wallpaper_win="$(powershell.exe -NoProfile -Command "(Get-ItemProperty 'HKCU:\\Control Panel\\Desktop').WallPaper" | tr -d '\r')"

if [ -z "$wallpaper_win" ]; then
	echo "failed to detect Windows wallpaper" >&2
	exit 1
fi

drive_letter="$(printf '%s' "$wallpaper_win" | cut -c1 | tr '[:upper:]' '[:lower:]')"
wallpaper_rel="$(printf '%s' "$wallpaper_win" | cut -c3- | sed 's#\\#/#g')"
wallpaper_path="/mnt/$drive_letter$wallpaper_rel"
{{- else }}
echo "wallpaper generation is not supported on {{ .chezmoi.os }}" >&2
exit 1
{{- end }}

if [ ! -f "$wallpaper_path" ]; then
	echo "wallpaper not found: $wallpaper_path" >&2
	exit 1
fi

mkdir -p "$wezterm_dir/themes"

matugen image "$wallpaper_path" --json hex --mode dark --type scheme-tonal-spot --prefer saturation --dry-run >"$tmp_json"

jq '{
  none: "NONE",
  rosewater: .colors.on_secondary_container.dark.color,
  flamingo: .colors.on_tertiary_container.dark.color,
  pink: .colors.primary_fixed.dark.color,
  mauve: .colors.secondary_fixed.dark.color,
  red: .colors.error.dark.color,
  maroon: .colors.error_container.dark.color,
  peach: .colors.secondary.dark.color,
  yellow: .colors.primary_fixed.dark.color,
  green: .colors.primary.dark.color,
  teal: .colors.secondary.dark.color,
  sky: .colors.secondary_fixed.dark.color,
  sapphire: .colors.secondary_fixed.dark.color,
  blue: .colors.primary.dark.color,
  lavender: .colors.tertiary.dark.color,
  text: .colors.on_surface.dark.color,
  subtext1: .colors.on_surface_variant.dark.color,
  subtext0: .colors.outline.dark.color,
  overlay2: .colors.outline.dark.color,
  overlay1: .colors.outline_variant.dark.color,
  overlay0: .colors.surface_variant.dark.color,
  surface2: .colors.surface_container_high.dark.color,
  surface1: .colors.surface_container.dark.color,
  surface0: .colors.surface_container_low.dark.color,
  base: .colors.background.dark.color,
  mantle: .colors.surface.dark.color,
  crust: .colors.surface_dim.dark.color
}' "$tmp_json" >"$generated_palette_file"

python3 - "$tmp_json" "$generated_theme_file" <<'PY'
import json
import sys

src, dst = sys.argv[1], sys.argv[2]
with open(src, "r", encoding="utf-8") as fh:
    data = json.load(fh)["colors"]

def color(name):
    return data[name]["dark"]["color"]

theme = """[metadata]
name = "generated"

[colors]
foreground = "{foreground}"
background = "{background}"
cursor_bg = "{cursor_bg}"
cursor_fg = "{cursor_fg}"
cursor_border = "{cursor_border}"
selection_bg = "{selection_bg}"
selection_fg = "{selection_fg}"
split = "{split}"
scrollbar_thumb = "{scrollbar_thumb}"
compose_cursor = "{compose_cursor}"

ansi = [
  "{ansi0}",
  "{ansi1}",
  "{ansi2}",
  "{ansi3}",
  "{ansi4}",
  "{ansi5}",
  "{ansi6}",
  "{ansi7}",
]

brights = [
  "{bright0}",
  "{bright1}",
  "{bright2}",
  "{bright3}",
  "{bright4}",
  "{bright5}",
  "{bright6}",
  "{bright7}",
]

indexed = __INDEXED__
"""

theme = theme.format(
    foreground=color("on_surface"),
    background=color("background"),
    cursor_bg=color("primary"),
    cursor_fg=color("background"),
    cursor_border=color("primary"),
    selection_bg=color("surface_variant"),
    selection_fg=color("on_surface"),
    split=color("outline_variant"),
    scrollbar_thumb=color("surface_container_high"),
    compose_cursor=color("secondary"),
    ansi0=color("surface_dim"),
    ansi1=color("error"),
    ansi2=color("primary"),
    ansi3=color("primary_fixed"),
    ansi4=color("primary_fixed"),
    ansi5=color("secondary"),
    ansi6=color("tertiary"),
    ansi7=color("on_surface"),
    bright0=color("outline_variant"),
    bright1=color("error_container"),
    bright2=color("primary_fixed"),
    bright3=color("primary_fixed_dim"),
    bright4=color("secondary_fixed"),
    bright5=color("secondary_fixed"),
    bright6=color("tertiary_fixed"),
    bright7=color("on_surface_variant"),
)
theme = theme.replace(
    "__INDEXED__",
    '{ 16 = "' + color("secondary_fixed") + '", 17 = "' + color("surface_container") + '" }',
)

with open(dst, "w", encoding="utf-8") as fh:
    fh.write(theme)
PY

printf 'theme = "generated"\n' >"$active_scheme_file"
printf 'generated\n' >"$wezterm_dir/theme"

{{- if eq .chezmoi.os "linux" }}
if [ -d "/mnt/c/Users/$USER" ]; then
	mkdir -p "$windows_wezterm_dir/themes"
	cp -f "$generated_theme_file" "$windows_wezterm_dir/themes/generated.toml"
	cp -f "$generated_palette_file" "$windows_wezterm_dir/generated_palette.json"
fi
{{- end }}

echo "generated theme from $wallpaper_path"
