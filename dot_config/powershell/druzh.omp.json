{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "console_title_template": "{{ .HostName }} :: {{ .PWD }}",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "session",
          "style": "plain",
          "foreground": "#8aadf4",
          "template": "{{ .HostName }} "
        },
        {
          "type": "path",
          "style": "plain",
          "foreground": "#a6da95",
          "properties": {
            "style": "folder"
          },
          "template": "{{ .Path }} "
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#eed49f",
          "properties": {
            "fetch_status": true
          },
          "template": "on  {{ .HEAD }}{{ if or (.Working.Changed) (.Staging.Changed) }}*{{ end }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#939ab7",
          "template": "╰─"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#c6a0f6",
          "template": "❯"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#f5bde6",
          "template": "❯ "
        }
      ]
    }
  ],
  "secondary_prompt": {
    "foreground": "#939ab7",
    "template": "❯❯ "
  },
  "transient_prompt": {
    "foreground": "#c6a0f6",
    "template": "❯ "
  }
}
