local function read_background_mode()
	local file = io.open(background_mode_file, "r")
	if not file then
		return "image"
	end

	local mode = file:read("*l")
	file:close()

	if mode == "solid" then
		return "solid"
	end

	return "image"
end

local function write_background_mode(mode)
	local file = io.open(background_mode_file, "w")
	if not file then
		return false
	end

	file:write(mode, "\n")
	file:close()
	return true
end
local theme_state = theme.apply(config)
local theme_colors = theme_state.colors
local solid_background_color = theme_colors.background or "#1e2030"
local window_background_opacity = opacity.apply(config)
local solid_background_rgba = F.hex_to_rgba(solid_background_color, window_background_opacity)

local background_mode = read_background_mode()
