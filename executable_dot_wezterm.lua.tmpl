wezterm.on("toggle-background-mode", function(window, pane)
	local next_mode = wezterm.GLOBAL.solid_background_mode and "image" or "solid"
	if not write_background_mode(next_mode) then
		window:toast_notification("wezterm", "failed to write background mode", nil, 3000)
		return
	end
	window:perform_action(act.ReloadConfiguration, pane)
end)

